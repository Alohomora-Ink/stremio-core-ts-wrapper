// ============================================================================
// HOOK TESTERS
// ============================================================================

function AggregatedMetaTester({ args }: { args: any }) {
  const { meta, isLoading, sources, raw } = useAggregatedMeta(
    args.type,
    args.id
  ); // <--- Destructure raw

  // Helper to extract just video structure for comparison
  const simplifyVideos = (metaItem: any) => {
    if (!metaItem?.videos) return "No Videos";
    // Return first 3 and last 3 videos to see structure
    const v = metaItem.videos;
    const sample = [...v.slice(0, 2), ...v.slice(-2)];
    return {
      count: v.length,
      sample: sample.map((vid: any) => ({
        id: vid.id,
        season: vid.season,
        episode: vid.episode,
        title: vid.name
      }))
    };
  };

  const comparison = raw
    ? Object.entries(raw).reduce(
        (acc, [name, data]) => {
          acc[name] = simplifyVideos(data);
          return acc;
        },
        {} as Record<string, any>
      )
    : {};

  const displayData = {
    STATUS: isLoading ? "LOADING..." : "READY",
    META_NAME: meta?.name,
    SOURCES_QUERIED: sources,
    // This is the "Diff" we need:
    VIDEO_STRUCTURE_COMPARISON: comparison
  };

  return (
    <div className="flex flex-col gap-2">
      <div
        className={`rounded p-2 text-xs font-bold ${isLoading ? "bg-yellow-900/30 text-yellow-500" : "bg-green-900/30 text-green-500"}`}
      >
        {isLoading ? "Loading..." : "Done"}
      </div>
      <JSONTreeCustom data={displayData} />
    </div>
  );
}

interface StreamListContainerProps {
  type: string;
  meta: MetaItem;
  episode?: MetaVideo;
}

function StreamAggregatorTester({
  type,
  meta,
  episode
}: StreamListContainerProps) {
  const { streams, isLoading } = useAggregatedStreams({
    type,
    meta,
    episode
  });

  const displayData = {
    STATUS: isLoading ? "LOADING..." : "READY",
    TOTAL_STREAMS: streams.length,
    SOURCES_QUERIED: streams,
    STREAMS: streams // This is what we need to see JSON for
  };

  return (
    <div className="flex flex-col gap-2">
      <div
        className={`rounded p-2 text-xs font-bold ${isLoading ? "bg-yellow-900/30 text-yellow-500" : "bg-green-900/30 text-green-500"}`}
      >
        {isLoading
          ? "Fetching Streams..."
          : `Fetched ${streams.length} streams from ${sources.filter((s) => s.count > 0).length} addons.`}
      </div>
      <JSONTreeCustom data={displayData} />
    </div>
  );
}

